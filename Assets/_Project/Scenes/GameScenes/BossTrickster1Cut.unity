--- !u!114 &630247044
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 630247043}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 551c9008559e478498bb45a6cee1c1c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem
  speakerNameText: {fileID: 1401742079}
  dialogueText: {fileID: 1401742078}
  dialoguePanel: {fileID: 1401742076}
  pauseGameDuringDialogue: 0
  playOnStart: 1
  textSpeed: 0.05
  dialogue:
    lines:
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u044D\u0439\u0431"
      text: "\u041E\u043D... \u0438\u0441\u0447\u0435\u0437. \u041C\u044B \u043F\u043E\u0431\u0435\u0434\u0438\u043B\u0438."
    - characterIcon: {fileID: 0}
      speakerName: "\u041B\u0430\u043D\u0441\u0435\u043B\u043E\u0441\u044C"
      text: "\u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E... \u044D\u0442\u043E
        \u043A\u043E\u0448\u043C\u0430\u0440 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u041F\u043E\u0440\u0442\u0430\u043B \u0437\u0430\u043A\u0440\u044B\u0442.
        \u0414\u0435\u043C\u043E\u043D \u0438\u0437\u0433\u043D\u0430\u043D. \u041D\u043E..."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u044D\u0439\u0431"
      text: "\u041D\u043E?"
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u041A\u043E\u0440\u043E\u043B\u044C \u0410\u0440\u0442\u0443\u0440\u0438\u043D...
        \u0435\u0433\u043E \u0434\u0443\u0448\u0430 \u0431\u044B\u043B\u0430 \u0441\u0432\u044F\u0437\u0430\u043D\u0430
        \u0441 \u0428\u0443\u0442\u043E\u043C.\n\u041A\u043E\u0433\u0434\u0430 \u044F
        \u0438\u0437\u0433\u043D\u0430\u043B \u0434\u0435\u043C\u043E\u043D\u0430...
        \u044F... \u044F \u043D\u0435 \u0441\u043C\u043E\u0433 \u043E\u0442\u0434\u0435\u043B\u0438\u0442\u044C
        \u0438\u0445."
    - characterIcon: {fileID: 0}
      speakerName: "\u041B\u0430\u043D\u0441\u0435\u043B\u043E\u0441\u044C"
      text: "\u0422\u044B \u0445\u043E\u0447\u0435\u0448\u044C \u0441\u043A\u0430\u0437\u0430\u0442\u044C..."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u041A\u043E\u0440\u043E\u043B\u044C \u043F\u043E\u0433\u0438\u0431.
        \u0415\u0433\u043E \u0434\u0443\u0448\u0430 \u0443\u0448\u043B\u0430 \u0432\u043C\u0435\u0441\u0442\u0435
        \u0441 \u0434\u0435\u043C\u043E\u043D\u043E\u043C \u0432 \u0431\u0435\u0437\u0434\u043D\u0443.\n\u042F
        \u0443\u0431\u0438\u043B \u0435\u0433\u043E. \u042F \u0443\u0431\u0438\u043B
        \u0441\u0432\u043E\u0435\u0433\u043E \u043A\u043E\u0440\u043E\u043B\u044F."
    - characterIcon: {fileID: 0}
      speakerName: "\u041B\u0430\u043D\u0441\u0435\u043B\u043E\u0441\u044C"
      text: "\u041D\u0435\u0442. \u041A\u043E\u0440\u043E\u043B\u044C \u043F\u043E\u0433\u0438\u0431
        \u0432 \u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442, \u043A\u043E\u0433\u0434\u0430
        \u043D\u0430\u0434\u0435\u043B \u043C\u0430\u0441\u043A\u0443.\n\u0422\u044B
        \u0441\u043F\u0430\u0441 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u043E.
        \u0422\u044B \u0438\u0441\u043A\u0443\u043F\u0438\u043B \u0441\u0432\u043E\u044E
        \u0432\u0438\u043D\u0443."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u041D\u043E \u043A\u0430\u043A\u043E\u0439 \u0446\u0435\u043D\u043E\u0439..."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u044D\u0439\u0431"
      text: ...
    - characterIcon: {fileID: 0}
      speakerName: "\u041B\u0430\u043D\u0441\u0435\u043B\u043E\u0441\u044C"
      text: ...
  onDialogueComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 105135218}
        m_TargetAssemblyTypeName: MoreMountains.TopDownEngine.LevelManager, MoreMountains.TopDownEngine
        m_MethodName: GotoLevel
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: LevelSelection
          m_BoolArgument: 0
        m_CallState: 2
