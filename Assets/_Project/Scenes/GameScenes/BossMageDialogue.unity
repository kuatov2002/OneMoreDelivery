--- !u!114 &1879462251
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1879462250}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 551c9008559e478498bb45a6cee1c1c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem
  speakerNameText: {fileID: 528701098}
  dialogueText: {fileID: 528701097}
  dialoguePanel: {fileID: 528701095}
  pauseGameDuringDialogue: 0
  playOnStart: 1
  textSpeed: 0.05
  dialogue:
    lines:
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u041D-\u043D\u0435\u0442... \u043D\u0435\u0442, \u043D\u0435\u0442,
        \u041D\u0415\u0422! \u0427\u0442\u043E \u044F... \u0447\u0442\u043E \u044F
        \u0441\u0434\u0435\u043B\u0430\u043B?!"
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u044D\u0439\u0431"
      text: "\u041C\u0443\u0440\u043B\u0438\u043D? \u0412\u044B \u043C\u0435\u043D\u044F
        \u0441\u043B\u044B\u0448\u0438\u0442\u0435? \u041C\u0430\u0441\u043A\u0430
        \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u0442
        \u0432\u0430\u0441."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u041C\u044D\u0439\u0431... \u0434\u0438\u0442\u044F \u043C\u043E\u0451...
        \u044F \u043F\u044B\u0442\u0430\u043B\u0441\u044F \u0443\u0431\u0438\u0442\u044C
        \u0442\u0435\u0431\u044F. \u041C\u043E\u0438\u043C\u0438 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
        \u0440\u0443\u043A\u0430\u043C\u0438 \u044F..."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u044D\u0439\u0431"
      text: "\u0412\u044B \u0431\u044B\u043B\u0438 \u043F\u043E\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C.
        \u041A\u0430\u043A \u0438 \u044F. \u041A\u0430\u043A \u0438 \u0432\u0441\u0435
        \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u041D\u043E \u0438\u043C\u0435\u043D\u043D\u043E \u044F... \u0438\u043C\u0435\u043D\u043D\u043E
        \u044F \u0432\u043F\u0443\u0441\u0442\u0438\u043B \u044D\u0442\u043E \u0437\u043B\u043E
        \u0432 \u043D\u0430\u0448 \u043C\u0438\u0440. \u041A\u0430\u043A \u0436\u0435
        \u043B\u0435\u0433\u0447\u0435 \u0441\u0442\u0430\u043B\u043E \u0431\u0435\u0437
        \u043C\u0430\u0441\u043A\u0438...\n\u043D\u043E \u0433\u0440\u0443\u0437
        \u0432\u0438\u043D\u044B... \u043E\u043D \u0442\u044F\u0436\u0435\u043B\u0435\u0435
        \u043B\u044E\u0431\u043E\u0433\u043E \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u044F."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u044D\u0439\u0431"
      text: "\u0422\u043E\u0433\u0434\u0430 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0438\u0442\u0435
        \u043C\u043D\u0435 \u0432\u0441\u0451. \u041F\u0440\u044F\u043C\u043E \u0441\u0435\u0439\u0447\u0430\u0441.
        \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0437\u043D\u0430\u0442\u044C,
        \u043E\u0442\u043A\u0443\u0434\u0430 \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C
        \u044D\u0442\u0438 \u043C\u0430\u0441\u043A\u0438.\n\u0421\u044D\u0440 \u041B\u0430\u043D\u0441\u0435\u043B\u043E\u0441\u044C
        \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F \u0432 \u0442\u0440\u043E\u043D\u043D\u044B\u0439
        \u0437\u0430\u043B, \u043F\u0440\u044F\u043C\u0438\u043A\u043E\u043C \u043A
        \u0441\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u044E. \u0415\u043C\u0443
        \u043D\u0443\u0436\u043D\u0430 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u0422\u0440\u0438 \u043D\u0435\u0434\u0435\u043B\u0438 \u043D\u0430\u0437\u0430\u0434...
        \u043A\u043E\u0440\u043E\u043B\u044C \u0410\u0440\u0442\u0443\u0440\u0438\u043D
        \u043F\u0440\u0438\u0437\u0432\u0430\u043B \u043C\u0435\u043D\u044F \u043D\u043E\u0447\u044C\u044E.
        \u041E\u043D \u0431\u044B\u043B... \u0438\u0437\u043C\u0435\u043D\u0451\u043D.\n\u041E\u0434\u0435\u0440\u0436\u0438\u043C
        \u0438\u0434\u0435\u0435\u0439 \u0431\u0435\u0441\u0441\u043C\u0435\u0440\u0442\u0438\u044F.
        \u0412\u043E\u0439\u043D\u044B \u0438\u0441\u0442\u043E\u0449\u0438\u043B\u0438
        \u0435\u0433\u043E, \u0441\u043C\u0435\u0440\u0442\u044C \u0431\u0440\u0430\u0442\u0430
        \u0441\u043B\u043E\u043C\u0438\u043B\u0430 \u0434\u0443\u0445."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u044D\u0439\u0431"
      text: "\u041F\u0440\u0438\u043D\u0446 \u0413\u0430\u043B\u0430\u0445 \u043F\u043E\u0433\u0438\u0431
        \u0432 \u0431\u043E\u044E \u043F\u043E\u043B\u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434.
        \u041D\u043E \u043A\u0430\u043A \u044D\u0442\u043E \u0438\u043C\u0435\u0435\u0442
        \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435 \u043A..."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u041A\u043E\u0440\u043E\u043B\u044C \u043D\u0435 \u043C\u043E\u0433
        \u0441\u043C\u0438\u0440\u0438\u0442\u044C\u0441\u044F. \u041E\u043D \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B,
        \u0447\u0442\u043E\u0431\u044B \u044F \u043D\u0430\u0448\u0451\u043B \u0441\u043F\u043E\u0441\u043E\u0431.
        \u041B\u044E\u0431\u043E\u0439 \u0441\u043F\u043E\u0441\u043E\u0431.\n\u042F
        \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0441\u044F. \u0421\u043D\u043E\u0432\u0430
        \u0438 \u0441\u043D\u043E\u0432\u0430. \u041D\u043E \u043E\u043D \u0431\u044B\u043B
        \u043A\u043E\u0440\u043E\u043B\u0451\u043C. \u041E\u043D \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u043B
        \u043C\u043D\u0435."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u044D\u0439\u0431"
      text: "\u0412\u044B \u043F\u0440\u0438\u0437\u0432\u0430\u043B\u0438 \u0434\u0435\u043C\u043E\u043D\u0430."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0440\u0438\u0442\u0443\u0430\u043B.
        \u0417\u0430\u043F\u0440\u0435\u0442\u043D\u044B\u0439. \u0418\u0437 \u043A\u043D\u0438\u0433\u0438,
        \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0434\u043E\u043B\u0436\u043D\u0430
        \u0431\u044B\u043B\u0430 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
        \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u043D\u043E\u0439
        \u043D\u0430\u0432\u0435\u043A\u0438.\n\u042F \u0434\u0443\u043C\u0430\u043B...
        \u044F \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u0441\u043C\u043E\u0433\u0443
        \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C
        \u0435\u0433\u043E. \u0417\u0430\u043A\u043B\u044E\u0447\u0438\u0442\u044C
        \u0441\u0434\u0435\u043B\u043A\u0443 \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
        \u043E\u0431\u0440\u0430\u0442\u043D\u043E."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u044D\u0439\u0431"
      text: "\u041D\u043E \u0447\u0442\u043E-\u0442\u043E \u043F\u043E\u0448\u043B\u043E
        \u043D\u0435 \u0442\u0430\u043A."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u0412\u0441\u0451 \u043F\u043E\u0448\u043B\u043E \u043D\u0435 \u0442\u0430\u043A
        \u0441 \u0441\u0430\u043C\u043E\u0433\u043E \u043D\u0430\u0447\u0430\u043B\u0430!
        \u0414\u0435\u043C\u043E\u043D... \u043E\u043D \u043D\u0430\u0437\u0432\u0430\u043B
        \u0441\u0435\u0431\u044F \u0428\u0443\u0442\u043E\u043C.\n\u0413\u043E\u0432\u043E\u0440\u0438\u043B
        \u0437\u0430\u0433\u0430\u0434\u043A\u0430\u043C\u0438. \u0421\u043C\u0435\u044F\u043B\u0441\u044F,
        \u043A\u043E\u0433\u0434\u0430 \u043A\u043E\u0440\u043E\u043B\u044C \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B
        \u0431\u0435\u0441\u0441\u043C\u0435\u0440\u0442\u0438\u044F.\n\u0421\u043A\u0430\u0437\u0430\u043B,
        \u0447\u0442\u043E \u043A\u043E\u0440\u043E\u043B\u044C \u043F\u043E\u043B\u0443\u0447\u0438\u0442
        \u0442\u043E, \u0447\u0442\u043E \u043F\u0440\u043E\u0441\u0438\u0442 \u2014
        \u0432\u0435\u0447\u043D\u0443\u044E \u0436\u0438\u0437\u043D\u044C. \u041D\u043E
        \u043D\u0435 \u0443\u0442\u043E\u0447\u043D\u0438\u043B \u043A\u0430\u043A\u0443\u044E."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u044D\u0439\u0431"
      text: "\u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
        \u0441 \u043A\u043E\u0440\u043E\u043B\u0451\u043C \u0410\u0440\u0442\u0443\u0440\u0438\u043D\u043E\u043C?"
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u0414\u0435\u043C\u043E\u043D \u0434\u0430\u043B \u0435\u043C\u0443
        \u043C\u0430\u0441\u043A\u0443. \u0417\u043E\u043B\u043E\u0442\u0443\u044E,
        \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u043D\u0443\u044E \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u044B\u043C\u0438
        \u043A\u0430\u043C\u043D\u044F\u043C\u0438.\n\u0421\u043A\u0430\u0437\u0430\u043B
        \u2014 \u043D\u0430\u0434\u0435\u043D\u044C \u0435\u0451, \u0438 \u0441\u043C\u0435\u0440\u0442\u044C
        \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043A\u043E\u0441\u043D\u0451\u0442\u0441\u044F
        \u0442\u0435\u0431\u044F.\n\u041A\u043E\u0440\u043E\u043B\u044C... \u043A\u043E\u0440\u043E\u043B\u044C
        \u043D\u0430\u0434\u0435\u043B \u0435\u0451 \u0431\u0435\u0437 \u043A\u043E\u043B\u0435\u0431\u0430\u043D\u0438\u0439."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u044D\u0439\u0431"
      text: "\u0418?"
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u0418 \u0438\u0441\u0447\u0435\u0437. \u041F\u0440\u043E\u0441\u0442\u043E
        \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0441\u044F \u0432
        \u0432\u043E\u0437\u0434\u0443\u0445\u0435. \u041E\u0441\u0442\u0430\u043B\u0441\u044F
        \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043C\u0435\u0445 \u0434\u0435\u043C\u043E\u043D\u0430.\n\u041E\u043D
        \u0441\u043A\u0430\u0437\u0430\u043B: \"\u041A\u043E\u0440\u043E\u043B\u044C
        \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0432\u0435\u0447\u043D\u0443\u044E
        \u0436\u0438\u0437\u043D\u044C \u2014 \u043E\u043D \u0442\u0435\u043F\u0435\u0440\u044C
        \u0447\u0430\u0441\u0442\u044C \u043C\u043E\u0435\u0433\u043E \u0442\u0435\u0430\u0442\u0440\u0430.
        \u041D\u0430\u0432\u0441\u0435\u0433\u0434\u0430.\"\n\u0410 \u043F\u043E\u0442\u043E\u043C...
        \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C
        \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043C\u0430\u0441\u043A\u0438.
        \u0421\u043E\u0442\u043D\u0438 \u0438\u0445. \u041F\u043E \u0432\u0441\u0435\u043C\u0443
        \u0437\u0430\u043C\u043A\u0443."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u044D\u0439\u0431"
      text: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u043B\u044E\u0434\u0435\u0439
        \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u044B?"
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u042F \u043D\u0435 \u0437\u043D\u0430\u044E. \u041C\u0430\u0441\u043A\u0438
        \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C
        \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u0443
        \u0437\u0430 \u043E\u0434\u043D\u0443 \u043D\u043E\u0447\u044C.\n\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438,
        \u0441\u043B\u0443\u0433\u0438, \u0440\u044B\u0446\u0430\u0440\u0438... \u0434\u0430\u0436\u0435
        \u0434\u0435\u0442\u0438. \u0412\u0441\u0435, \u043A\u0442\u043E \u043D\u0430\u0434\u0435\u043B
        \u043C\u0430\u0441\u043A\u0443, \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C
        \u043C\u0430\u0440\u0438\u043E\u043D\u0435\u0442\u043A\u0430\u043C\u0438.\n\u041C\u0430\u0440\u0438\u043E\u043D\u0435\u0442\u043A\u0430\u043C\u0438
        \u0434\u0435\u043C\u043E\u043D\u0430-\u0448\u0443\u0442\u0430."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u044D\u0439\u0431"
      text: "\u0410 \u0432\u044B? \u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u044B
        \u043D\u0430\u0434\u0435\u043B\u0438 \u043C\u0430\u0441\u043A\u0443?"
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u042F \u043F\u044B\u0442\u0430\u043B\u0441\u044F \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
        \u0438\u0445. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B
        \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F,
        \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0431\u0430\u0440\u044C\u0435\u0440\u044B.\n\u041D\u043E
        \u043C\u0430\u0441\u043A\u0438... \u043E\u043D\u0438 \u043D\u0430\u0448\u0435\u043F\u0442\u044B\u0432\u0430\u043B\u0438.
        \u041E\u0431\u0435\u0449\u0430\u043B\u0438 \u0441\u0438\u043B\u0443. \u041E\u0431\u0435\u0449\u0430\u043B\u0438
        \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u043C\u043E\u044E
        \u043E\u0448\u0438\u0431\u043A\u0443.\n\u0412 \u043C\u043E\u043C\u0435\u043D\u0442
        \u0441\u043B\u0430\u0431\u043E\u0441\u0442\u0438... \u044F \u043F\u043E\u0434\u0434\u0430\u043B\u0441\u044F."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u044D\u0439\u0431"
      text: "\u041D\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u0432\u044B \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B.
        \u0418 \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u043C\u043E\u0447\u044C
        \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u044D\u0442\u043E.\n\u041B\u0430\u043D\u0441\u0435\u043B\u043E\u0441\u044C
        \u0441\u0435\u0439\u0447\u0430\u0441 \u0438\u0434\u0451\u0442 \u043A \u0434\u0435\u043C\u043E\u043D\u0443.
        \u0415\u043C\u0443 \u043D\u0443\u0436\u043D\u0430 \u043D\u0430\u0448\u0430
        \u043F\u043E\u043C\u043E\u0449\u044C."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u0412\u044B \u043F\u0440\u0430\u0432\u044B. \u042D\u0442\u043E \u043C\u043E\u044F
        \u0432\u0438\u043D\u0430. \u0418 \u044F \u0434\u043E\u043B\u0436\u0435\u043D
        \u0432\u0441\u0451 \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C.\n\u0414\u0435\u043C\u043E\u043D-\u0448\u0443\u0442
        \u0441\u0435\u0439\u0447\u0430\u0441 \u0432 \u0442\u0440\u043E\u043D\u043D\u043E\u043C
        \u0437\u0430\u043B\u0435 \u2014 \u043E\u043D \u0432\u043E\u0441\u0441\u0435\u0434\u0430\u0435\u0442
        \u043D\u0430 \u0442\u0440\u043E\u043D\u0435 \u043A\u043E\u0440\u043E\u043B\u044F.\n\u0418\u0437\u0434\u0435\u0432\u0430\u0435\u0442\u0441\u044F
        \u043D\u0430\u0434 \u043D\u0430\u043C\u0438. \u041F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442
        \u043D\u0430\u0448\u0435 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u043E
        \u0432 \u0446\u0438\u0440\u043A \u0431\u0435\u0437\u0443\u043C\u0438\u044F."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u044D\u0439\u0431"
      text: "\u0422\u043E\u0433\u0434\u0430 \u043D\u0443\u0436\u043D\u043E \u0441\u0440\u043E\u0447\u043D\u043E
        \u043F\u043E\u043C\u043E\u0447\u044C \u041B\u0430\u043D\u0441\u0435\u043B\u043E\u0441\u044E,
        \u043F\u043E\u043A\u0430 \u043D\u0435 \u043F\u043E\u0437\u0434\u043D\u043E!
        \u0415\u0441\u043B\u0438 \u0434\u0435\u043C\u043E\u043D \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
        \u0441\u0438\u043B\u0451\u043D..."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u041D\u0435 \u0431\u0443\u0434\u0435\u043C \u0442\u0435\u0440\u044F\u0442\u044C
        \u043D\u0438 \u043C\u0438\u043D\u0443\u0442\u044B! \u0423 \u043C\u0435\u043D\u044F
        \u0435\u0441\u0442\u044C \u0441\u0442\u0430\u0440\u044B\u0435 \u0437\u0430\u043F\u0438\u0441\u0438
        \u043E \u0434\u0435\u043C\u043E\u043D\u0430\u0445-\u0448\u0443\u0442\u0430\u0445.\n\u0418\u0445
        \u0441\u043B\u0430\u0431\u043E\u0441\u0442\u0438, \u0438\u0445 \u0443\u043B\u043E\u0432\u043A\u0438.
        \u0415\u0441\u043B\u0438 \u043C\u044B \u0443\u0441\u043F\u0435\u0435\u043C
        \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0434\u043E \u0442\u0440\u043E\u043D\u043D\u043E\u0433\u043E
        \u0437\u0430\u043B\u0430 \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A..."
    - characterIcon: {fileID: 0}
      speakerName: "\u0413\u041E\u041B\u041E\u0421 \u0428\u0423\u0422\u0410 (\u043E\u0442\u043A\u0443\u0434\u0430-\u0442\u043E
        \u0441\u0432\u0435\u0440\u0445\u0443)"
      text: "\u041E, \u043A\u0430\u043A \u0442\u0440\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u043E!
        \u041A\u0443\u043A\u043B\u043E\u0432\u043E\u0434 \u0440\u0430\u0441\u043A\u0430\u044F\u043B\u0441\u044F!
        \u041C\u0430\u0440\u0438\u043E\u043D\u0435\u0442\u043A\u0438 \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u043B\u0438\u0441\u044C!\n\u041D\u043E
        \u0441\u043F\u0435\u043A\u0442\u0430\u043A\u043B\u044C \u0442\u043E\u043B\u044C\u043A\u043E
        \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F, \u043C\u043E\u0438
        \u0434\u043E\u0440\u043E\u0433\u0438\u0435 \u0434\u0440\u0443\u0437\u044C\u044F!\n\u0424\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439
        \u0430\u043A\u0442 \u0431\u0443\u0434\u0435\u0442... \u041D\u0415\u0417\u0410\u0411\u042B\u0412\u0410\u0415\u041C\u042B\u041C!"
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u044D\u0439\u0431"
      text: "\u041E\u043D \u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E \u043C\u044B
        \u0438\u0434\u0451\u043C."
    - characterIcon: {fileID: 0}
      speakerName: "\u041C\u0443\u0440\u043B\u0438\u043D"
      text: "\u0422\u043E\u0433\u0434\u0430 \u0434\u0430\u0432\u0430\u0439\u0442\u0435
        \u043D\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043C \u0435\u0433\u043E
        \u0436\u0434\u0430\u0442\u044C. \u0417\u0430 \u041B\u0430\u043D\u0441\u0435\u043B\u043E\u0441\u044F.
        \u0417\u0430 \u043A\u043E\u0440\u043E\u043B\u044F. \u0417\u0430 \u0432\u0441\u0435\u0445,
        \u043A\u0442\u043E \u043F\u0430\u043B \u0436\u0435\u0440\u0442\u0432\u043E\u0439
        \u043C\u043E\u0435\u0439 \u0433\u043B\u0443\u043F\u043E\u0441\u0442\u0438."
  onDialogueComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 105135218}
        m_TargetAssemblyTypeName: MoreMountains.TopDownEngine.LevelManager, MoreMountains.TopDownEngine
        m_MethodName: GotoLevel
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: BossTrickster
          m_BoolArgument: 0
        m_CallState: 2
